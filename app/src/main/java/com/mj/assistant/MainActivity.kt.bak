fun ActionsScreen() {
    LazyColumn(
        Modifier.fillMaxSize(),
        contentPadding = PaddingValues(18.dp),
        verticalArrangement = Arrangement.spacedBy(10.dp)
    ) {
        item {
            Text("Quick Actions", fontSize = 23.sp, fontWeight = FontWeight.SemiBold)
            Spacer(Modifier.height(5.dp))
