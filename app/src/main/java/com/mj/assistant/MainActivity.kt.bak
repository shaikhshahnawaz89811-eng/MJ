        item {
            ActionCard("Bluetooth", Icons.Outlined.Bluetooth, "Device control")
        }
        item {
            ActionCard("Battery", Icons.Outlined.BatteryFull, "Device info")
        }
        item {
            ActionCard("Time", Icons.Outlined.Schedule, "Device info")
        }
        item {
            ActionCard("Date", Icons.Outlined.CalendarToday, "Device info")
        }
    }
}

@Composable
fun ActionCard(name: String, icon: androidx.compose.ui.graphics.vector.ImageVector, sub: String) {
    Card(
        Modifier.fillMaxWidth(),
        shape = RoundedCornerShape(18.dp),
        colors = CardDefaults.cardColors(containerColor = Surface)
    ) {
        Row(
            Modifier.padding(16.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Box(
                Modifier.size(45.dp).clip(CircleShape)
                    .background(Purple.copy(.12f)),
                contentAlignment = Alignment.Center
            ) {
                Icon(icon, null, tint = Purple)
            }
            Spacer(Modifier.width(13.dp))
            Column(Modifier.weight(1f)) {
                Text(name, fontWeight = FontWeight.Medium)
                Text(sub, color = TextMuted, fontSize = 12.sp)
            }
            Icon(Icons.Outlined.ChevronRight, null, tint = TextMuted)
        }
    }
}

@Composable
fun ProfileScreen() {
    LazyColumn(
        Modifier.fillMaxSize(),
        contentPadding = PaddingValues(20.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        item {
            Spacer(Modifier.height(20.dp))
            Box(
                Modifier.size(105.dp).clip(CircleShape)
                    .background(Purple2.copy(.35f))
                    .border(1.dp, Purple.copy(.6f), CircleShape),
                contentAlignment = Alignment.Center
            ) {
                Text("MJ", fontSize = 34.sp, fontWeight = FontWeight.Bold)
            }
            Spacer(Modifier.height(14.dp))
            Text("MJ", fontSize = 25.sp, fontWeight = FontWeight.SemiBold)
            Text("Voice assistant", color = TextMuted)
