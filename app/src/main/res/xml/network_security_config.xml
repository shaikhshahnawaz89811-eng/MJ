<?xml version="1.0" encoding="utf-8"?>
<!-- Local AI Brain (see com.mj.assistant.brain) talks to a loopback server the user
     configures in Settings — default http://127.0.0.1:8090, plain HTTP since it never
     leaves the device. Without this file, Android blocks ALL cleartext traffic by
     default for apps targeting API 28+ (this app targets 35) — including to localhost —
     so the Brain feature's own default configuration would silently fail to connect on
     every real device. This exempts ONLY the loopback address, not the whole app: the
     base cleartextTrafficPermitted stays false, so Tavily (and anything else) must
     still use HTTPS. If the Brain's base URL is ever changed to a real hostname in
     Settings, that connection is NOT covered here and should be HTTPS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
